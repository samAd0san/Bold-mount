# Bold Mount env vars. Copy to .env and fill in; never commit real values.

# MongoDB Atlas connection string — the dedicated Bold Mount cluster (open to Vercel; the DB user's password protects it).
MONGODB_URI=
# Database name; must be "boldmount" (or boldmount-<suffix>), the code refuses anything else.
MONGODB_DB=boldmount

# Random 32+ character secret that signs customer session cookies (e.g. openssl rand -hex 32).
AUTH_SECRET=

# Cloudinary account for product photo uploads (folder bold-mount/products).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth web client for "Continue with Google"; blank hides the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay keys for online payment (UPI / GPay / cards); blank turns online payment off, WhatsApp orders still work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public site origin (e.g. https://boldmount.in) for Google redirects and same-site checks; blank locally = taken from the request.
APP_URL=
# Optional: forward /api/* to a separate API server (no trailing slash). Leave blank — the API runs on Vercel with the site.
API_ORIGIN=

# Optional: public site URL used in links and the sitemap.
NEXT_PUBLIC_SITE_URL=
